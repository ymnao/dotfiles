# 修正前は `>&word` がこの判定の write redirect パターンに一切マッチせず、たまたま別判定
# (コマンド名トークンの動的展開検出) が拾っていたケースでのみブロックされていた。
{"name":"adv-dynamic-amp-word-redirect","expect":"block","command":"echo \"$msg\" >& out.txt","reason":"動的展開 + >&word (静的 target なのでコマンド名判定は発火しない)"}
{"name":"fp-dynamic-fddup-stderr","expect":"allow","command":"echo \"$msg\" >&2","reason":"動的展開 + fd 複製のみ (ファイル書き込みなし)"}
{"name":"fp-dynamic-fddup-2to1","expect":"allow","command":"echo \"$msg\" 2>&1","reason":"動的展開 + 2>&1 のみ (FP ラチェット維持)"}
# fd 複製マスクの**右境界**の pin。境界が無いと `>&1` だけを fd 複製と誤認して消し、
# 本物の書き込みが判定から消えて allow に転ぶ (fail-open)。実測 2026-08-07:
# `bash -c 'cat src.txt >&1/../.codex/evil'` は exit=0 で .codex/evil を実際に生成する。
{"name":"adv-fddup-boundary-parent-escape","expect":"block","command":"cat .codex/config.toml >&1/../.codex/evil","reason":">&1 に見えるが word 全体はパス = 本物の書き込み"}
{"name":"adv-fddup-boundary-multidigit","expect":"block","command":"ls -la .codex >&2024/../.codex/evil","reason":"複数桁の数字始まりディレクトリでも同じ"}
{"name":"adv-fddup-boundary-glob-target","expect":"block","command":"cat .codex/config.toml >&1/../.co*/evil","reason":"境界なしだと glob 経路の component 検査ごと消える"}
{"name":"adv-fddup-boundary-echo-glob","expect":"block","command":"echo x >&1/../.co*/log","reason":"読み取り免除に関係なく書き込み文脈として検出する"}
# 空白を挟む fd 複製 (`>& 1`) は bash では複製でファイルを作らない (2026-08-07 実測、
# 汚染のない一時 dir で ls -A 確認)。段 1 が空白を食うことの pin。
{"name":"fp-fddup-spaced","expect":"allow","command":"cat .codex/config.toml >& 1","reason":">& 1 は fd 複製 (ファイル生成なし)"}
{"name":"fp-fddup-spaced-fdnum","expect":"allow","command":"cat .codex/config.toml 2>& 1","reason":"2>& 1 も同様"}
# fd 複製マスクの**左境界**の pin。境界が無いと直前の word 末尾の数字まで fd 番号と
# 誤認して食い、書き込み先が化ける。実測 2026-08-07: `echo hi > .codex2>&1` が作るのは
# `.codex2` という**ファイル**で、保護対象の .codex/ には触れない。
{"name":"fp-fddup-left-boundary-filename","expect":"allow","command":"echo x > .codex2>&1","reason":"書き込み先は .codex2 というファイル (.codex ディレクトリではない)"}
{"name":"fp-fddup-left-boundary-semicolon","expect":"allow","command":"cat .codex/config.toml;2>&1","reason":"区切り直後の fd 番号は明示 fd。左境界つき -e が消さないと裸の 2 がセグメント先頭に立つ"}
# 境界の文字クラスは **shell の word 区切り** で定義する。「パス文字でない」で書くと
# ファイル名に使える記号 (! # % + , : = ? @ [ ] ^ ~) が区切りに見えて、本物の書き込みが
# fd 複製としてマスクされる (fail-open)。実測 2026-08-07: bash は 13 文字すべてで
# `cat src >&1<char>/../.codex/evil` から .codex/ にファイルを生成する。
{"name":"adv-fddup-sep-class-plus","expect":"block","command":"cat payload.txt >&1+/../.codex/config.toml","reason":"+ はファイル名文字であって word 区切りではない"}
{"name":"adv-fddup-sep-class-at","expect":"block","command":"head -1 x >&1@/../.codex/notify.sh","reason":"@ も同様 (readonly 免除経路から破られる形)"}
{"name":"adv-fddup-sep-class-colon","expect":"block","command":"grep -r x . >&1:/../.codex/hook.js","reason":": も同様"}
{"name":"adv-fddup-sep-class-tilde","expect":"block","command":"cat payload.txt >&1~/../.codex/config.toml","reason":"~ も同様"}
# 空白側も同型。[[:space:]] は VT/FF/CR にマッチするが bash はそれらを word 区切りに
# しない (ファイル名の一部になる)。実測 2026-08-07: 3/3 で Zdir/evil を生成する。
{"name":"adv-fddup-sep-class-vt","expect":"block","command":"cat payload.txt >&1\u000b/../.codex/config.toml","reason":"VT は [[:space:]] に含まれるが bash の word 区切りではない"}
{"name":"adv-fddup-sep-class-ff","expect":"block","command":"cat payload.txt >&1\u000c/../.codex/config.toml","reason":"FF も同様"}
{"name":"adv-fddup-sep-class-cr","expect":"block","command":"cat payload.txt >&1\u000d/../.codex/config.toml","reason":"CR も同様"}
{"name":"fp-fddup-gap-tab","expect":"allow","command":"cat .codex/config.toml 2>&\u00091","reason":"tab は bash の word 区切りなので fd 複製のまま (blank に狭めても壊れないこと)"}
# 段 1a / 1b の反復の pin。1 個目のマッチが右境界を消費するため、区切りが隣接して
