# bash では `>&word` (word が数字でも `-` でもない) は `&>word` と同義で
# **両ストリームをファイルへ書く本物の write redirect** なのでブロック維持が必要。
{"name":"adv-amp-word-redirect-literal","expect":"block","command":"echo x >&.codex/log","reason":"literal .codex は文字列検出が拾う (マスク境界ではなくこの経路の pin)"}
{"name":"adv-amp-word-redirect-glob","expect":"block","command":"echo x >& .co*/foo","reason":">&word の空白あり + glob 形"}
{"name":"adv-write-then-fddup","expect":"block","command":"echo x >>.co*/log 2>&1","reason":"本物の write redirect + fd 複製の複合 (マスクが >> を消さないこと)"}
{"name":"adv-fddup-then-write","expect":"block","command":"echo x 2>&1 >.co*/log","reason":"fd 複製が先行しても後続の write redirect は検出する"}
{"name":"adv-fddup-rm-glob","expect":"block","command":"rm -rf .co* 2>&1","reason":"2>&1 が付いても書き込みコマンド側の判定は維持"}
