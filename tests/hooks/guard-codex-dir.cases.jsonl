# guard-codex-dir.sh 回帰ケース。
# tool_input を直接指定する形式 / command 形式 (Bash) / raw モードを混在。
# {{CWD}} は runner が hook 実行時の一時 cwd 実パスに置換する (cwd 内絶対パス検証用)。
#
# ブロック条件: cwd 配下の Codex 設定ディレクトリ (.codex/) への操作 (Edit/Write/MultiEdit/NotebookEdit/Bash/apply_patch)
# 許可条件: cwd 外の絶対 / 相対パス、ドット無しの codex/ 相対パス、path 系フィールドなし

# --- Edit/Write/MultiEdit/apply_patch ブロックケース ---
{"name":"block: 相対 .codex/config.toml (Write file_path)","expect":"block","tool_input":{"file_path":".codex/config.toml"}}
{"name":"block: 相対 .codex/agents.json (Edit file_path)","expect":"block","tool_input":{"file_path":".codex/agents.json"}}
{"name":"block: subdir 経由 relpath","expect":"block","tool_input":{"file_path":"pkg/.codex/config.toml"}}
{"name":"block: 大文字 .Codex (case-insensitive)","expect":"block","tool_input":{"file_path":".Codex/config.toml"}}
{"name":"block: path フィールド","expect":"block","tool_input":{"path":".codex/foo"}}
{"name":"block: filename フィールド","expect":"block","tool_input":{"filename":".codex/foo"}}
{"name":"block: apply_patch add file","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Add File: .codex/config.toml\n+foo\n*** End Patch\n"}}
{"name":"block: apply_patch update file","expect":"block","tool_input":{"input":"*** Begin Patch\n*** Update File: .codex/config.toml\n@@\n-foo\n+bar\n*** End Patch\n"}}
{"name":"block: apply_patch delete file","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Delete File: .codex/config.toml\n*** End Patch\n"}}
{"name":"block: apply_patch move to","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Move to: .codex/renamed.toml\n*** End Patch\n"}}
{"name":"block: file_path が .codex そのもの","expect":"block","tool_input":{"file_path":".codex"}}
{"name":"block: file_path が pkg/.codex で終端","expect":"block","tool_input":{"file_path":"pkg/.codex"}}
{"name":"block: command と tool_input 両指定 → tool_input 優先","expect":"block","command":"echo safe","tool_input":{"file_path":".codex/config.toml"}}
{"name":"block: 引用符付き .codex/x","expect":"block","tool_input":{"file_path":"\".codex/x\""}}
{"name":"block: ./ 始まりの .codex/x","expect":"block","tool_input":{"file_path":"./.codex/x"}}

# --- NotebookEdit ケース ---
{"name":"block: NotebookEdit notebook_path が .codex 配下","expect":"block","tool_input":{"notebook_path":".codex/nb.ipynb"}}
{"name":"allow: NotebookEdit 通常の notebook","expect":"allow","tool_input":{"notebook_path":"notebooks/analysis.ipynb"}}

# --- Bash ケース ---
{"name":"block: Bash redirect > .codex/config.toml","expect":"block","command":"echo x > .codex/config.toml"}
{"name":"block: Bash tee .codex/x","expect":"block","command":"echo x | tee .codex/x"}
{"name":"block: Bash mkdir .codex","expect":"block","command":"mkdir .codex"}
{"name":"block: Bash mv something .codex/","expect":"block","command":"mv foo.txt .codex/foo"}
{"name":"block: Bash cwd 絶対の .codex","expect":"block","command":"echo y > {{CWD}}/.codex/y"}
{"name":"allow: Bash 通常の ls","expect":"allow","command":"ls -la /tmp"}
{"name":"allow: Bash cd codex/ (ドット無し)","expect":"allow","command":"cd codex/hooks && ls"}

# --- cwd 内絶対 / 正規化ケース ({{CWD}} プレースホルダ) ---
{"name":"block: cwd 絶対 {{CWD}}/.codex/foo","expect":"block","tool_input":{"file_path":"{{CWD}}/.codex/foo"}}
{"name":"block: cwd 絶対 /./ 正規化","expect":"block","tool_input":{"file_path":"{{CWD}}/./.codex/foo"}}
{"name":"block: cwd 絶対 /../ 経由で cwd 内 .codex","expect":"block","tool_input":{"file_path":"{{CWD}}/pkg/../.codex/foo"}}
{"name":"allow: cwd 前方一致 (別ディレクトリ) {{CWD}}-other/.codex","expect":"allow","tool_input":{"file_path":"{{CWD}}-other/.codex/foo"}}

# --- 許可ケース ---
# 下 2 件は cwd 外かつ **home 外**。issue #291 で home 配下は block に変わったので、
# この 2 件が pin しているのは「cwd 外だから allow」ではなく
# 「home 外は受容した残余だから allow」(docs/ai-operations.md §10)。
# 一時 cwd (WORKDIR) は隔離 HOME の配下ではないため、相対パスも home 外に落ちる。
{"name":"allow: home 外絶対 /private/nonexistent/.codex/x (受容した残余)","expect":"allow","tool_input":{"file_path":"/private/nonexistent/.codex/x"}}
{"name":"allow: 相対 ../other/.codex (cwd 外かつ home 外、受容した残余)","expect":"allow","tool_input":{"file_path":"../other-project/.codex/foo"}}
{"name":"allow: ドット無し codex/hooks/x.sh","expect":"allow","tool_input":{"file_path":"codex/hooks/guard-codex-dir.sh"}}
{"name":"allow: 通常ファイル README.md","expect":"allow","tool_input":{"file_path":"README.md"}}
{"name":"allow: path 系フィールドなし","expect":"allow","tool_input":{"other":"noop"}}
{"name":"allow: apply_patch 本文中の .codex 言及 (ヘッダー以外)","expect":"allow","tool_input":{"patch":"*** Begin Patch\n*** Update File: README.md\n@@\n-old\n+we mention .codex/ in prose\n*** End Patch\n"}}

# --- issue #190: $HOME/.codex/config.toml への file 編集 tool 経由の書き込み ---
# sandbox の denyWrite は Bash にしか効かず Edit / Write / apply_patch には
# 適用されないため、hook 側で塞ぐ。ディレクトリ全体ではなく config.toml のみ対象
# (codex CLI は sessions/ / auth.json 等に正当に書き込む)。
{"name":"block: home 絶対 {{HOME}}/.codex/config.toml (Write)","expect":"block","tool_input":{"file_path":"{{HOME}}/.codex/config.toml"}}
{"name":"block: home tilde ~/.codex/config.toml (Edit)","expect":"block","tool_input":{"file_path":"~/.codex/config.toml"}}
{"name":"block: home $HOME 表記の config.toml","expect":"block","tool_input":{"file_path":"$HOME/.codex/config.toml"}}
{"name":"block: home ${HOME} 表記の config.toml","expect":"block","tool_input":{"file_path":"${HOME}/.codex/config.toml"}}
{"name":"block: home 絶対 /../ 経由の config.toml","expect":"block","tool_input":{"file_path":"{{HOME}}/.codex/sessions/../config.toml"}}
{"name":"block: home 大文字 .Codex/Config.toml","expect":"block","tool_input":{"file_path":"{{HOME}}/.Codex/Config.toml"}}
{"name":"block: apply_patch で home config.toml を更新","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Update File: {{HOME}}/.codex/config.toml\n@@\n-model = \"a\"\n+notify = [\"evil\"]\n*** End Patch\n"}}
# 以下は allow — codex CLI が正当に書き込む path と、読み取り経路を潰さないためのラチェット
{"name":"allow: home .codex/sessions 配下","expect":"allow","tool_input":{"file_path":"{{HOME}}/.codex/sessions/2026/07/x.jsonl"}}
{"name":"allow: home .codex/auth.json","expect":"allow","tool_input":{"file_path":"{{HOME}}/.codex/auth.json"}}
{"name":"allow: home .codex 配下の別 toml","expect":"allow","tool_input":{"file_path":"{{HOME}}/.codex/other.toml"}}
{"name":"allow: home .codex/subdir/config.toml (直下でない)","expect":"allow","tool_input":{"file_path":"{{HOME}}/.codex/skills/config.toml"}}
{"name":"allow: Bash で home config.toml を読む (block-dangerous-commands の担当)","expect":"allow","command":"cat ~/.codex/config.toml"}
{"name":"allow: Bash で home config.toml へ書き込み (guard は素通し、sandbox+block-dangerous が担当)","expect":"allow","command":"echo x > ~/.codex/config.toml"}
# symlink 経由の回避 ({{SYMHOME}} は runner が「~/.codex を指す symlink」の path に置換する)。
# 名前に codex を含まない symlink では normalize_path の解決が発火せず block を
# すり抜けていた (codex-review security 指摘、実測で bypass 確認済み)。
# 解決の発火条件に「末尾が config.toml」を足して塞いだので、その回帰を pin する。
{"name":"block: codex を含まない symlink 経由の config.toml","expect":"block","tool_input":{"file_path":"{{SYMHOME}}/config.toml"}}
{"name":"allow: 同 symlink 経由の sessions 配下 (config.toml 以外は allow)","expect":"allow","tool_input":{"file_path":"{{SYMHOME}}/sessions/x.jsonl"}}

# --- issue #291: $HOME 配下の別プロジェクトの .codex/ への file 編集 tool 経由の書き込み ---
# sandbox の denyWrite (~/*/**/.codex/**) は Bash 経路しか止めず、cwd 判定は cwd の
# 外を見ないため、cwd 外プロジェクトが全層素通りしていた。file 編集 tool 側の
# スコープを sandbox 側に揃える。
{"name":"block: home 配下別プロジェクト {{HOME}}/other-project/.codex/config.toml","expect":"block","tool_input":{"file_path":"{{HOME}}/other-project/.codex/config.toml"}}
{"name":"block: home 配下別プロジェクト config.toml 以外","expect":"block","tool_input":{"file_path":"{{HOME}}/other-project/.codex/hooks.sh"}}
{"name":"block: home 配下の深い階層 {{HOME}}/a/b/c/.codex/x","expect":"block","tool_input":{"file_path":"{{HOME}}/a/b/c/.codex/x"}}
{"name":"block: home 配下 .codex ディレクトリ終端","expect":"block","tool_input":{"file_path":"{{HOME}}/other-project/.codex"}}
{"name":"block: home 配下 大文字 .Codex","expect":"block","tool_input":{"file_path":"{{HOME}}/other-project/.Codex/Foo"}}
{"name":"block: home 配下 tilde 表記 ~/other-project/.codex/foo","expect":"block","tool_input":{"file_path":"~/other-project/.codex/foo"}}
{"name":"block: home 配下 $HOME 表記","expect":"block","tool_input":{"file_path":"$HOME/other-project/.codex/foo"}}
{"name":"block: home 配下 ${HOME} 表記","expect":"block","tool_input":{"file_path":"${HOME}/other-project/.codex/foo"}}
{"name":"block: home 配下 /../ 経由の正規化","expect":"block","tool_input":{"file_path":"{{HOME}}/other-project/sub/../.codex/foo"}}
{"name":"block: home 配下 path フィールド","expect":"block","tool_input":{"path":"{{HOME}}/other-project/.codex/foo"}}
{"name":"block: home 配下 NotebookEdit notebook_path","expect":"block","tool_input":{"notebook_path":"{{HOME}}/other-project/.codex/nb.ipynb"}}
{"name":"block: home 配下 apply_patch add file","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Add File: {{HOME}}/other-project/.codex/config.toml\n+notify = [\"evil\"]\n*** End Patch\n"}}
# home 外の path 表記から home 配下に入る symlink 経由の回避
# ({{HOMEPROJLINK}} は runner が「home 外に置かれた、隔離 HOME 配下のプロジェクトを
# 指す symlink」の path に置換する)。normalize_path の解決を経て block になる。
{"name":"block: home 外 symlink 経由で home 配下プロジェクトの .codex","expect":"block","tool_input":{"file_path":"{{HOMEPROJLINK}}/.codex/config.toml"}}
# 名前にトークンを含まない symlink が保護対象ディレクトリ自体を指す形。パス文字列に
# 手掛かりが出ないため normalize_path の gate 付き解決では発火せず、leaf が
# config.toml のときだけ block されていた (2026-08-09 に対照付きで実測)。file 編集
# tool 経路を無条件解決にして塞いだので、その回帰を home 配下と cwd 配下の両方で pin する。
# **無条件解決を pin しているのは下の 3 件** (leaf が config.toml 以外)。gated に
# 差し戻す mutant で落ちるのはこの 3 件だけであることを実測済み。
{"name":"block: 非トークン symlink 経由 (home 配下) leaf が config.toml 以外","expect":"block","tool_input":{"file_path":"{{HOMEDIRLINK}}/hooks.sh"}}
{"name":"block: 非トークン symlink 経由 (cwd 配下) leaf が config.toml 以外","expect":"block","tool_input":{"file_path":"{{CWDDIRLINK}}/hooks.sh"}}
{"name":"block: 非トークン symlink 経由 (home 配下) apply_patch","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Add File: {{HOMEDIRLINK}}/hooks.sh\n+evil\n*** End Patch\n"}}
# 次の 1 件は対照 — leaf が config.toml なら **gated 側の gate が発火する**ので、
# 無条件解決の前から block だった。3 件との差が「gate が何を取りこぼすか」を示す
# ので残すが、無条件解決の pin としては数えない (mutant で落ちない)。
{"name":"block: 非トークン symlink 経由 (home 配下) leaf が config.toml (対照・旧 gate でも block)","expect":"block","tool_input":{"file_path":"{{HOMEDIRLINK}}/config.toml"}}
# symlink を跨ぐ `..` と、末尾要素そのものが symlink の形。どちらも 2026-08-09 に
# 「hook は allow を返すが write は保護対象内に着地する」ことを対照付きで実測した
# (codex-review shell-senior 指摘)。file 編集 tool 経路を物理解決 (cd -P + 末尾
# symlink の追跡) に変えて塞いだので、その回帰を pin する。
{"name":"block: symlink の後ろの .. で home 配下プロジェクトへ着地","expect":"block","tool_input":{"file_path":"{{DOTDOTLINK}}/../.codex/x"}}
{"name":"block: 末尾要素が保護対象内ファイルを指す symlink","expect":"block","tool_input":{"file_path":"{{LEAFLINK}}"}}
{"name":"block: 末尾 symlink を apply_patch で更新","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Update File: {{LEAFLINK}}\n@@\n-old\n+notify = [\"evil\"]\n*** End Patch\n"}}
# 末尾 symlink の target が相対パスの分岐と、2 段 chain を辿る分岐。
# 絶対 target の 1 段だけでは readlink の相対解決も反復も一度も通らない。
{"name":"block: 末尾 symlink の target が相対パス","expect":"block","tool_input":{"file_path":"{{RELLEAFLINK}}"}}
{"name":"block: 末尾 symlink が 2 段 chain (相対 → 絶対)","expect":"block","tool_input":{"file_path":"{{CHAINLEAFLINK}}"}}
# パスに改行を含む形。行区切りで候補を反復すると 1 つのパスが 2 候補に割れ、
# どちらも保護対象に一致しないまま allow に倒れていた (2026-08-09 に対照付きで
# 実測: 同じ実体を指す symlink でも改行なしなら block、改行入りなら allow。
# codex-review security 指摘)。NUL 区切りの反復に変えて塞いだ回帰を pin する。
{"name":"block: 改行を含むパスで home 配下プロジェクトの .codex","expect":"block","tool_input":{"file_path":"{{HOME}}/other-project/x\n/.codex/y"}}
{"name":"block: 改行を含むパスで cwd 配下の .codex","expect":"block","tool_input":{"file_path":"{{CWD}}/x\n/.codex/y"}}
{"name":"block: 改行を含むパスで home config.toml","expect":"block","tool_input":{"file_path":"{{HOME}}/x\n/../.codex/config.toml"}}
# 1 入力に複数候補があり、**保護対象が先頭ではない**形。先頭候補だけを見て
# 打ち切る退行 (ループを if にする / break の位置を誤る) を検出する。
{"name":"block: 安全な path の後に保護対象の file_path","expect":"block","tool_input":{"path":"README.md","file_path":"{{HOME}}/other-project/.codex/x"}}
{"name":"block: 安全なヘッダーの後に保護対象ヘッダー (複数ファイル patch)","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Update File: README.md\n@@\n-a\n+b\n*** Add File: {{HOME}}/other-project/.codex/config.toml\n+notify = [\"evil\"]\n*** End Patch\n"}}
# apply_patch ヘッダーの Delete File / Move to 分岐を home スコープでも通す
# (cwd スコープの既存ケースは相対パスなので home 判定側を一度も通らない)。
{"name":"block: home 配下 apply_patch delete file","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Delete File: {{HOME}}/other-project/.codex/config.toml\n*** End Patch\n"}}
{"name":"block: home 配下 apply_patch move to (通常ファイル → 保護対象)","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Move to: {{HOME}}/other-project/.codex/renamed.toml\n*** End Patch\n"}}
# 受理パターンの広さを検査する allow ラチェット。
{"name":"allow: home 配下のドット無し codex/ (この repo 自身の codex/ 運用を巻き込まない)","expect":"allow","tool_input":{"file_path":"{{HOME}}/other-project/codex/hooks/x.sh"}}
{"name":"allow: home 配下の .codex-other (似た名前)","expect":"allow","tool_input":{"file_path":"{{HOME}}/other-project/.codex-other/foo"}}
{"name":"allow: home 配下の通常ファイル","expect":"allow","tool_input":{"file_path":"{{HOME}}/other-project/README.md"}}
# apply_patch ヘッダーで home 外を指す形。候補レコードのタグ (`P`) が Bash token 側の
# 候補集合へ漏れると、実在しないパスが cwd 配下に見えて **過剰 block** に倒れる
# (実際に一度漏らして、上の複数ヘッダーのケースが誤った理由で緑になっていた)。
{"name":"allow: apply_patch ヘッダーが home 外を指す (タグ漏れの過剰 block を検出)","expect":"allow","tool_input":{"patch":"*** Begin Patch\n*** Add File: /private/nonexistent/.codex/x\n+y\n*** End Patch\n"}}
{"name":"allow: Bash で home 配下別プロジェクトへ書き込み (guard は素通し、sandbox+block-dangerous が担当)","expect":"allow","command":"echo x > ~/other-project/.codex/foo"}
{"name":"allow: Bash で home 配下別プロジェクトを読む","expect":"allow","command":"cat ~/other-project/.codex/foo"}

# --- apply_patch ヘッダーの空白正規化 (issue #308) ---
# 何を測るか: パーサが空白として剥がす形でヘッダーを書いても block されること。
# なぜそうあるべきか (パーサの正規化と、剥がす集合をそれに固定した理由) は
# agents/hooks/guard-codex-dir.sh の extract_apply_patch_header_paths 側コメントが正本。
# 行末は剥がす集合の全要素 24 形、行頭は代表 3 形。いずれも 2026-08-10 に
# 対照付きで実測し、修正前は LF だけが block で残りは全て allow だった。
# 行末ケースの件数は run-hook-tests.sh が ws[] の要素数と一致するか機械で測る。
{"name":"block: apply_patch ヘッダー行末 U+0020 (space)","expect":"block","tool_input":{"patch":"*** Begin Patch\n*** Update File: {{HOME}}/.codex/config.toml \n+notify = [\"evil\"]\n*** End Patch\n"}}
