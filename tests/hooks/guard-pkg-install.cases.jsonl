{"name":"redir-dq-brace-pnpm-add","expect":"block","command":">\"a}b\" pnpm add foo","reason":"引用の中の } (#480)"}
{"name":"assign-sq-lt-pnpm-add","expect":"block","command":"FOO='a<b' pnpm add foo","reason":"代入の値の引用の中の < (#480)"}
{"name":"echo-subst-nested-backtick-pnpm-add","expect":"block","command":"echo $(echo `pnpm add foo`)","reason":"置換の中に入れ子になったバックティック (#480)"}
{"name":"cat-psub-nested-backtick-pnpm-add","expect":"block","command":"cat <(echo `pnpm add foo`)","reason":"プロセス置換の中のバックティック (#480)"}
{"name":"echo-subst-deep-backtick-pnpm-add","expect":"block","command":"echo $(echo $(echo `pnpm add foo`))","reason":"2 段の置換の中のバックティック (#480)"}
{"name":"leading-herestring-pnpm-add","expect":"block","command":"<<<x pnpm add foo","reason":"先頭のヒアストリングの語は実行対象ではない (#480)"}
{"name":"leading-herestring-blank-pnpm-add","expect":"block","command":"<<< x pnpm add foo","reason":"<<< の後に空白 (#480)"}
{"name":"coproc-pnpm-add","expect":"block","command":"coproc pnpm add foo","reason":"coproc は直後の語を実行する (#480)"}
{"name":"noglob-pnpm-add","expect":"block","command":"noglob pnpm add foo","reason":"zsh の noglob は直後の語を実行する (#480)"}
{"name":"nocorrect-pnpm-add","expect":"block","command":"nocorrect pnpm add foo","reason":"zsh の nocorrect は直後の語を実行する (#480)"}
{"name":"git-commit-msg-pnpm-add","expect":"allow","command":"git commit -m \"fix pnpm add\"","reason":"引用の中の PM 名は実行されない (#480 で粗い判定を足さなかった)"}
{"name":"grep-n-quoted-pnpm-add","expect":"allow","command":"grep -n \"pnpm add\" HANDOFF.md","reason":"ラッパーでないコマンドの値オプションでは安全網を発火させない (#480)"}
{"name":"if-n-quoted-blank","expect":"allow","command":"if [ -n \"a b\" ]; then echo pnpm; fi","reason":"予約語は安全網の対象のラッパーに入れない (#480)"}
{"name":"assign-sq-bracket-echo-pnpm-add","expect":"allow","command":"P='[a]' echo pnpm add","reason":"引用の中の ] は語を割らないので安全網を発火させない (#480)"}
{"name":"env-u-dq-blank-ls","expect":"allow","command":"env -u \"a b\" ls","reason":"安全網が発火しても PM 名がなければ許可 (#480)"}
{"name":"leading-herestring-cat","expect":"allow","command":"<<<x cat","reason":"ヒアストリングの語を消す形を足しても PM 名がなければ許可 (#480)"}
{"name":"noglob-ls","expect":"allow","command":"noglob ls *.txt","reason":"noglob を読み飛ばしても PM 名がなければ許可 (#480)"}
{"name":"echo-subst-nested-backtick-date","expect":"allow","command":"echo $(echo `date`)","reason":"入れ子のバックティックを解いても PM 操作がなければ許可 (#480)"}
{"name":"herestring-mid-segment-pnpm-add","expect":"block","command":"cat <<<x; <<<y pnpm add foo","reason":"2 つ目の segment の先頭のヒアストリング (#480)"}
{"name":"subst-psub-backtick-pnpm-add","expect":"block","command":"echo $(cat <(echo `pnpm add foo`))","reason":"置換 > プロセス置換 > バックティックの 3 段 (#480)"}
{"name":"coproc-upper-pnpm-add","expect":"block","command":"COPROC pnpm add foo","reason":"大文字の coproc (#480)"}
