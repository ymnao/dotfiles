# guard-sandbox-exclusions.sh の回帰ケース (issue #267)
#
# 判定規則: compound な行 (`;` `|` `&` 改行で 2 つ以上に割れる行) に除外コマンド名が
# 単語として現れたら、位置を問わずブロックする (粗い fail-closed)。クォート内 /
# エスケープされた区切り文字は区切りとして数えない。
#
# hook は隔離 HOME・一時 cwd で走るため settings.json は読めず、組み込み既定
# (docker / gh / brew / pnpm test:e2e) が使われる。
#
# block ケースの多くは、レビュー中に **実 sandbox で境界が外れることを live 実測した
# 入力**そのもの (2026-08-04 / Claude Code 2.1.212)。reason に「実測」と書いたものが
# それで、それ以外は判定ロジックの pin。docs/ai-operations.md §10 の実測表を参照。

# --- 実測で sandbox が外れた形 ---
{"name":"escape-brew-prefix","expect":"block","command":"brew --version > /dev/null && touch {{HOME}}/x.tmp","reason":"実測: 行全体が sandbox 外で走り ~/ への write が通った"}
{"name":"escape-gh-suffix","expect":"block","command":"touch {{HOME}}/x.tmp; gh --version","reason":"実測: 除外コマンドが後ろでも行全体が sandbox 外になる (順序非依存)"}
{"name":"escape-newline-separator","expect":"block","command":"touch {{HOME}}/x.tmp\ngh --version","reason":"実測: 改行区切りでも外れる。区切り集合から改行が漏れると 3 行に分けるだけで素通りする"}
{"name":"escape-wrapper-command","expect":"block","command":"ls {{HOME}}/.ssh; command gh --version","reason":"実測: 上流は wrapper コマンドを剥がして照合するため外れる"}
{"name":"escape-wrapper-command-p","expect":"block","command":"ls {{HOME}}/.ssh; command -p gh --version","reason":"実測: wrapper のオプション形 (command -p) でも外れる"}
{"name":"escape-wrapper-time-dashdash","expect":"block","command":"ls {{HOME}}/.ssh; time -- gh --version","reason":"実測: wrapper のオプション形 (time --) でも外れる"}
{"name":"escape-quote-split-word","expect":"block","command":"touch {{HOME}}/x.tmp; g\"h\" --version","reason":"実測: 上流はコマンド語のクォートを外して照合するため外れる"}
{"name":"escape-ansi-c-quoted-word","expect":"block","command":"touch {{HOME}}/x.tmp; $'gh' --version","reason":"ANSI-C 引用の先頭 $ を落とさないと `$gh` という語になって語一致を外れる (codex-review shell-senior 指摘)"}
{"name":"escape-locale-quoted-word","expect":"block","command":"touch {{HOME}}/x.tmp; $\"gh\" --version","reason":"ロケール引用も同様"}
{"name":"escape-backslash-split-word","expect":"block","command":"touch {{HOME}}/x.tmp; g\\h --version","reason":"上流はコマンド語のバックスラッシュも外して照合することの pin"}
{"name":"escape-assignment-quoted-value","expect":"block","command":"ls {{HOME}}/.aws; FOO='a b' gh --version","reason":"実測: クォート付きの環境変数代入を前置しても外れる"}
{"name":"escape-assignment-append","expect":"block","command":"ls {{HOME}}/.aws; FOO+=x gh --version","reason":"実測: append 代入 (+=) を前置しても外れる"}
{"name":"escape-quoted-redirect-char","expect":"block","command":"ls {{HOME}}/.aws; echo \">\"& gh --version","reason":"実測: クォート内の > を直前に置いても外れる。複製子判定がクォート状態を見ないと区切りの & を潰して素通りする"}
{"name":"escape-crlf-separator","expect":"block","command":"touch {{HOME}}/x.tmp\r\ngh --version","reason":"CRLF 改行でも区切りとして数える (実装は CR を明示的に区切り扱いしている)"}
{"name":"escape-cr-only-separator","expect":"block","command":"touch {{HOME}}/x.tmp\rgh --version","reason":"CR 単独 (旧 Mac 改行) でも同様"}
{"name":"escape-tab-after-separator","expect":"block","command":"ls {{HOME}}/.aws;\tgh --version","reason":"実測: 区切りの後がタブでも外れる。語境界判定が空白しか畳まないと素通りする"}
{"name":"escape-tab-indent-newline","expect":"block","command":"ls {{HOME}}/.aws\n\tgh --version","reason":"実測: 複数行ブロックのタブ字下げで素通りしていた形"}
{"name":"escape-tab-two-word-glob","expect":"block","command":"ls {{HOME}}; pnpm test:e2e\tspecs","reason":"2 語 glob の語間がタブでも検出することの pin"}
{"name":"escape-quote-between-redirect-and-amp","expect":"block","command":"ls >\"\"&gh --version","reason":"実測: > とクォートを挟むと区切りの & を複製子と誤認して素通りしていた (prev_raw をクォート読み取り時にリセットしないと再発する)"}
{"name":"escape-apostrophe-in-double-quotes","expect":"block","command":"echo \"don't\" > /dev/null; touch {{HOME}}/x.tmp; gh --version; echo \"it's\"","reason":"実測: 対にならないシングルクォートを含む行でも外れる。クォート span を正規表現で削除する実装だと区切りごと消えて素通りする"}

# --- 判定ロジックの pin (sandbox の挙動そのものは測っていない) ---
{"name":"escape-wrapper-timeout","expect":"block","command":"timeout 60 gh pr list && touch {{HOME}}/x.tmp","reason":"wrapper 前置 + compound の pin"}
{"name":"escape-wrapper-nohup","expect":"block","command":"nohup brew list && touch {{HOME}}/x.tmp","reason":"wrapper 前置 + compound の pin"}
{"name":"escape-docker-pipe","expect":"block","command":"docker ps | grep claude","reason":"パイプ後段と混在した除外コマンドの pin"}
{"name":"escape-pnpm-e2e","expect":"block","command":"pnpm test:e2e specs/login && touch {{HOME}}/x.tmp","reason":"2 語の除外 glob (pnpm test:e2e *) でも検出することの pin"}
{"name":"escape-env-assignment-prefix","expect":"block","command":"GH_PAGER=cat gh pr list; touch {{HOME}}/x.tmp","reason":"環境変数代入の前置 + compound の pin"}
{"name":"escape-pipe-to-sort","expect":"block","command":"gh pr list --state all --limit 1000 --json number -q '.[].number' | sort -u","reason":"クォート外のパイプは区切り。eval が使っていた形の pin"}

# --- 粗い fail-closed の代償: 言及しているだけの行も止まる ---
{"name":"block-string-mention-only","expect":"block","command":"echo \"this mentions gh --version only in a string\" > /dev/null; touch {{HOME}}/x.tmp","reason":"実 sandbox では外れない形だが、コマンド位置の判定をやめたため止まる。誤ブロックは呼び出しを分ければ解消でき、見逃しと非対称なので許容する (設計判断)"}
{"name":"block-string-mention-with-dollar","expect":"block","command":"echo \"home is $HOME; gh pr list is a command\" > /dev/null; touch {{HOME}}/x.tmp","reason":"同上"}

# --- 誤ブロックさせない形 ---
{"name":"allow-bare-gh","expect":"allow","command":"gh pr list","reason":"除外コマンドの単独実行は本 hook の対象外 (既存 skill の呼び方)"}
{"name":"allow-bare-gh-with-quoted-jq","expect":"allow","command":"gh issue view 267 --json body --jq '.body | length'","reason":"シングルクォート内のパイプを区切りとみなさない (skills/pr / skills/resolve が使う形)"}
{"name":"allow-bare-gh-with-redirect","expect":"allow","command":"gh pr view 1 2>&1","reason":"リダイレクト複製子の & を区切りとみなさない"}
{"name":"allow-command-substitution-argument","expect":"allow","command":"gh pr close \"$(gh pr view --json number -q .number)\"","reason":"区切り文字が 1 つも無いので早期スクリーニングで抜ける (判定本体には到達しない)"}
{"name":"allow-command-substitution-in-compound","expect":"allow","command":"x=$(brew --version); ls /etc","reason":"実測: 上流は command_substitution へ降下しないので sandbox は外れない。hook 側がこれを通すのは `$(brew` が 1 語になって語一致しないためで、理由は別物。**上流が降下し始めるとここが escape になる** — Claude Code upgrade 時に docs §10 の実測表を取り直すこと"}
{"name":"allow-subshell-in-compound","expect":"allow","command":"ls /etc; (gh --version)","reason":"実測: subshell にも降下しない。hook 側が通す理由は同上 (`(gh` が 1 語)。同じく上流更新で腐る前提"}
{"name":"allow-no-excluded-command","expect":"allow","command":"touch {{HOME}}/x.tmp && ls {{HOME}}","reason":"除外コマンドを含まない compound 行は素通しする"}
{"name":"allow-pnpm-install","expect":"allow","command":"pnpm install && make test","reason":"pnpm test:e2e * にマッチしない pnpm サブコマンドは対象外"}
{"name":"allow-wrapper-without-excluded-command","expect":"allow","command":"touch {{HOME}}/x.tmp; timeout --help","reason":"除外コマンドを含まない wrapper。旧実装ではオプション剥がしループが終端せず hook が hang していた形"}
{"name":"allow-stdbuf-no-operand","expect":"allow","command":"touch {{HOME}}/x.tmp; stdbuf -o0","reason":"同上 (hang していた形)"}
{"name":"allow-nice-no-operand","expect":"allow","command":"touch {{HOME}}/x.tmp; nice -n","reason":"同上 (hang していた形)"}
{"name":"allow-mention-in-shell-comment","expect":"allow","command":"git branch -D b 2>/dev/null || true       # gh pr close が消せなかった場合の保険\nrm -f HANDOFF.md","reason":"シェルコメント内の言及は落とす。落とさないと docs / eval の複数行ブロックが軒並みブロックされ、粗い判定の代償が過大になる"}
{"name":"allow-mention-in-leading-comment","expect":"allow","command":"# gh を使う手順はここには無い\nls /etc/hosts && echo ok","reason":"行頭コメントも同様"}
{"name":"block-hash-inside-word","expect":"block","command":"ls /etc/hosts; echo a#gh --version; gh --version","reason":"語中の # はコメント開始ではない (コメント除去を緩めすぎない)"}
{"name":"block-hash-after-quoted-space","expect":"block","command":"echo \"x \"#foo; gh --version","reason":"クォート由来の空白の直後の # はシェルでは語中扱いでコメントではない。デクォート後の文字で語頭判定すると、実在する `; gh --version` ごと捨てて素通りする"}
{"name":"block-hash-after-escaped-space","expect":"block","command":"echo a\\ #foo; gh --version","reason":"同上 (エスケープされた空白)"}
{"name":"block-hash-after-escaped-semicolon","expect":"block","command":"ls \\;#x; gh --version","reason":"同上 (エスケープされた区切り)"}
{"name":"allow-line-continuation-single-gh","expect":"allow","command":"gh api graphql -F query=@q.graphql -f owner=o \\\n  --jq '{ pr_number: 1 }'","reason":"バックスラッシュ行継続は区切りではない。数えると resolve skill の gh api graphql が起動即ブロックされる"}
{"name":"allow-line-continuation-multi","expect":"allow","command":"gh pr create --title x \\\n  --body-file b.md \\\n  --draft","reason":"複数段の行継続でも単独コマンド扱い"}
{"name":"block-line-continuation-then-mix","expect":"block","command":"gh pr list \\\n  --limit 5\nls .","reason":"行継続の後に本物の改行区切りがあれば compound として検出する (継続の扱いを緩めすぎない)"}

{"name":"escape-heredoc-quote-flip","expect":"block","command":"cat <<EOF\n\"\nEOF\ntouch {{HOME}}/x.tmp;gh --version\n# \"","reason":"here-document 本文の引用符でクォート状態が反転し、後続の実在する区切りを潰して素通りしていた (codex-review security が実証)。`<<` を含む行は生コマンドで分割する fail-closed に倒す"}
{"name":"block-heredoc-with-excluded-name","expect":"block","command":"cat > f.txt <<EOF\nrun gh later\nEOF","reason":"here-document を含む行は解析を諦めるので、本文中の言及だけでも止まる (許容した誤ブロック)"}
{"name":"block-unterminated-single-quote","expect":"block","command":"echo 'unterminated; touch {{HOME}}/x.tmp; gh --version","reason":"閉じていない引用符では解析結果を捨てて生コマンドで分割する (fail-closed) ことの pin"}
{"name":"block-unterminated-double-quote","expect":"block","command":"echo \"unterminated; touch {{HOME}}/x.tmp; gh --version","reason":"同上 (ダブルクォート)"}
{"name":"allow-empty-command","expect":"allow","command":"","reason":"command が空なら判定対象が無いので許可 (tool_input.command 欠落と同じ扱い)"}
# tool_input はあるが command キーが無い → 許可 (Bash 以外の tool 経由で来ても落ちない)
# raw:missing-command-key-allows|allow
{"tool_input": {"file_path": "x.txt"}}
# command が文字列でない (配列) → jq -r が要素を並べた文字列にするため判定は続行し、
# 区切りが無ければ許可になる。fail-safe が必要なのは「parse できない」入力の側。
# raw:non-string-command-allows|allow
{"tool_input": {"command": ["ls", "-la"]}}
# 壊れた入力は fail-safe でブロックする (判定を持たないまま許可に倒れないこと)
# raw:broken-json-fails-closed|block
{"tool_input": {"command": "gh pr list; touch x"
